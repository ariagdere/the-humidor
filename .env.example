# Railway'de Postgres eklediğinde bu değeri otomatik olarak sağlıyor
# (Variables sekmesinden kopyalayabilirsin). Yerelde test etmek için
# kendi Postgres'ine göre doldur.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Tüm /api/* rotalarını korur (frontend ve ESPHome gateway aynı anahtarı
# x-api-key başlığında gönderir). Boş bırakırsan API korumasız çalışır --
# sadece yerel geliştirmede kabul edilebilir, Railway'de mutlaka doldur.
API_KEY=

# Railway prod'da otomatik sağlar, yerelde varsayılan 3000 kullanılır
PORT=3000

# Bir sonraki adımda (AI künye çıkarma) kullanılacak
ANTHROPIC_API_KEY=
